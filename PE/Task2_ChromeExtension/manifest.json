{
  "manifest_version": 3,
  "name": "TaskFlow - Minimal To-Do List",
  "version": "1.0.0",
  "description": "A clean, minimal, and attractive to-do list Chrome extension with categories, dark/light theme, and live badge counter.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TaskFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
